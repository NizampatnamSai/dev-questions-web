# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Firebase service account (never commit — use FIREBASE_CREDENTIALS_JSON env var on Render)
firebase-service-account.json

# Node
node_modules/
dist/

# Env files — every variant, at any depth.
# Listing them one by one meant each new file had to be remembered: a timestamped
# backup (.env.bak.1787208446) was created and committed with a live JWT signing
# key, Mongo connection strings and Groq/Cloudinary credentials in it before
# anyone noticed. These patterns catch the whole family instead.
.env
.env.*
*.env
# ...but a checked-in TEMPLATE with placeholder values is useful, so allow those.
!.env.example
!.env.sample
!.env.template

# Local tracking (not committed)
FEATURE_BUG_LOG.md

# OS
.DS_Store
Thumbs.db
devquiz.apk/
# APK builds
client/public/*.apk
client/public/*.aab

# Source PDFs for IBPS PO previous-year papers — transcribed into
# client/src/data/ibpspo-pyq.json, the raw files stay local.
client/src/data/pyq-source/
